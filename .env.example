# ─── Supabase ───────────────────────────────────────────────────────────────
# `npm run db:start` imprime estos valores en local.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# SALTA RLS. Solo en el servidor y solo para crear usuarios y seeds.
SUPABASE_SERVICE_ROLE_KEY=
# Solo si el proyecto todavía firma con HS256. Los proyectos nuevos usan ES256
# con JWKS y no lo necesitan.
SUPABASE_JWT_SECRET=

# Conexión SQL directa.
# En producción: un rol dedicado con NOBYPASSRLS, nunca el superusuario.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Servidor ───────────────────────────────────────────────────────────────
PORT=3011
# Dominio del frontend en Vercel, separado por comas.
CORS_ORIGINS=http://localhost:3000

# ─── Pruebas ────────────────────────────────────────────────────────────────
API_URL=http://127.0.0.1:3011
